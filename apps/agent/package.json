{
  "name": "agent",
  "version": "0.1.0",
  "private": true,
  "description": "EngineeringOS Workforce Intelligence -- desktop activity/screenshot agent (plain Node process, not Electron -- see README)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "enroll": "tsx src/index.ts enroll",
    "start": "tsx src/index.ts start",
    "private:on": "tsx src/index.ts private on",
    "private:off": "tsx src/index.ts private off",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "screenshot-desktop": "^1.15.6"
  },
  "optionalDependencies": {
    "active-win": "^9.0.0",
    "desktop-idle": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.2"
  }
}
