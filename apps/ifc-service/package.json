{
  "name": "ifc-service",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone IFC processing service — parses IFC files, generates Fragments, extracts hierarchy/properties/quantities/materials/classifications/relationships. Deployable independently of apps/api; communicates only via the shared Redis queue and Postgres database.",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/bull": "^10.1.1",
    "bull": "^4.12.6",
    "ioredis": "^5.3.2",
    "postgres": "^3.4.4",
    "dotenv": "^16.4.5",
    "@aws-sdk/client-s3": "^3.577.0",
    "web-ifc": "0.0.77",
    "@thatopen/fragments": "3.4.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@engineeringos/types": "workspace:*"
  },
  "devDependencies": {
    "@swc/cli": "^0.4.0",
    "@swc/core": "^1.7.26",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": { "^.+\\.(t|j)s$": "ts-jest" },
    "testEnvironment": "node"
  }
}
