# ══════════════════════════════════════════════════════════════
# EngineeringOS™ Reality Capture — API Environment Variables
# Copy to .env.local for local development
# NEVER commit .env.local or .env to version control
# ══════════════════════════════════════════════════════════════

# Application
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database (matches docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=engineeringos
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT — CHANGE THESE IN PRODUCTION (min 32 random chars each)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Storage — MinIO local (matches docker-compose defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=engineeringos
S3_PUBLIC_URL=http://localhost:9000/engineeringos
S3_PRESIGN_EXPIRES_IN=3600

# Redis (matches docker-compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # uncomment if using auth

# Stripe (billing — stub in Phase 1, activate in MVP phase)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# AI Service (Phase 5) -- Python ai-service, used for semantic/vector search
# (Qdrant + embeddings) only. Capture/issue ingestion and the risk
# narrative layer also go through it.
# AI_SERVICE_URL=http://localhost:8001
# QDRANT_URL=http://localhost:6333

# AI Assistant Gateway (modules/ai) -- the user-facing assistant's own LLM
# provider, entirely separate from the ai-service keys above. AI_PROVIDER
# unset or "auto" picks gemini if GEMINI_API_KEY is set, else anthropic if
# ANTHROPIC_API_KEY is set; set it explicitly to force one. See
# modules/ai/providers/provider.factory.ts.
# AI_PROVIDER=auto
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-6

# Per-role AI assistant request limits ("dailyLimit,perMinuteLimit") --
# initial testing values, see config/ai.config.ts. Uncomment to override one
# role; any role without an override uses the built-in default.
# AI_LIMIT_CONSULTANT=30,10
# AI_LIMIT_DEFAULT=20,5

# Shared secret presented to the AI service (X-Internal-Service-Secret header) --
# it has no auth of its own otherwise. Must match apps/ai-service/.env's value.
# CHANGE THIS IN PRODUCTION (min 32 random chars).
INTERNAL_SERVICE_SECRET=dev-only-internal-secret-change-me-too

# Encrypts OAuth email-integration tokens (Outlook/Gmail) and BYO AI provider
# API keys at rest (common/crypto/CredentialEncryptionService). REQUIRED --
# the app refuses to start without this set to a random string of at least
# 32 characters (config/app.config.ts). There is no insecure fallback.
# CHANGE THIS IN PRODUCTION (min 32 random chars).
CREDENTIAL_ENCRYPTION_KEY=dev-only-credential-key-change-me-too-32ch

# Email (Phase 2 — notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@engineeringos.com

# Google Calendar integration (Workforce Intelligence) — unset by default;
# GET /workforce/calendar-integration/google-calendar/authorize-url returns
# an unusable URL until these are set to a real Google Cloud Console OAuth
# client. GOOGLE_OAUTH_REDIRECT_URI must exactly match a redirect URI
# configured on that OAuth client.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/workforce/calendar-integration/google-calendar/callback

# Phase 3C: Outlook/Microsoft Graph email integration (SETTINGS > EMAIL
# INTEGRATION) — unset by default; GET /email-integration/outlook/authorize-url
# returns an unusable URL until these are set to a real Microsoft Entra App
# Registration. Deliberately separate from the Google Calendar vars above —
# an independent app registration, no shared client. See
# docs/phase3-email-integration.md for exact Entra setup steps.
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# 'organizations' (default) accepts any Microsoft 365 work/school account
# from any organization, excludes personal Microsoft accounts. Set to a
# specific Entra tenant ID/domain to restrict this to one organization only.
# MICROSOFT_OAUTH_TENANT=organizations
# MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/email-integration/outlook/callback

# Phase 3D: Gmail email integration (SETTINGS > EMAIL INTEGRATION) — unset
# by default; GET /email-integration/gmail/authorize-url returns an
# unusable URL until these are set to a real Google Cloud Console OAuth
# client. Deliberately independent from GOOGLE_OAUTH_* above (Calendar) —
# no shared client, so neither integration can break the other. See
# docs/phase3-email-integration.md for exact Google Cloud Console setup
# steps and OAuth consent/verification requirements.
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/email-integration/gmail/callback
