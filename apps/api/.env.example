# ══════════════════════════════════════════════════════════════
# EngineeringOS™ Reality Capture — API Environment Variables
# Copy to .env.local for local development
# NEVER commit .env.local or .env to version control
# ══════════════════════════════════════════════════════════════

# Application
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173
API_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database (matches docker-compose defaults)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=engineeringos
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# JWT — CHANGE THESE IN PRODUCTION (min 32 random chars each)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Storage — MinIO local (matches docker-compose defaults)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=engineeringos
S3_PUBLIC_URL=http://localhost:9000/engineeringos
S3_PRESIGN_EXPIRES_IN=3600

# Redis (matches docker-compose defaults)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # uncomment if using auth

# Stripe (billing — stub in Phase 1, activate in MVP phase)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# AI Service (Phase 5)
# AI_SERVICE_URL=http://localhost:8001
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# QDRANT_URL=http://localhost:6333

# Email (Phase 2 — notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=noreply@engineeringos.com
