# Copy to .env before running (docker-compose reads apps/ai-service/.env directly).
# Defaults below match infrastructure/docker/docker-compose.yml service names/ports.

PORT=8001
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/engineeringos
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# At least one LLM provider is required for /assistant and narrative progress
# summaries. DEFAULT_LLM_PROVIDER selects the primary provider; if it's unset
# or the request fails, app/llm/provider.py falls through to OmniRoute, then
# Ollama, automatically -- nothing to toggle when a real key is added later.
DEFAULT_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://ollama:11434

# Local dev-only free-tier AI gateway (OpenAI-compatible, no API key needed).
# Not auto-started and not available outside this machine -- do not rely on
# it in production or any other environment.
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_MODEL=auto/best-coding

EMBEDDING_MODEL=all-MiniLM-L6-v2

S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=engineeringos
