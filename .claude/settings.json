{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != \"true\" ] || command -v markitdown >/dev/null || pip install -q \"markitdown[all] @ git+https://github.com/microsoft/markitdown.git#subdirectory=packages/markitdown\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/User/AppData/Roaming/Python/Python314/Scripts/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/User/AppData/Roaming/Python/Python314/Scripts/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ux-ui-agent-skills": {
      "source": {
        "source": "github",
        "repo": "plugin87/ux-ui-agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "ux-ui-agent-skills@ux-ui-agent-skills": true
  }
}
