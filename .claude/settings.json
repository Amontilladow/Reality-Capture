{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-guard.sh search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-guard.sh read"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/graphify-session-start.sh",
            "timeout": 600
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ux-ui-agent-skills": {
      "source": {
        "source": "github",
        "repo": "plugin87/ux-ui-agent-skills"
      }
    }
  },
  "enabledPlugins": {
    "ux-ui-agent-skills@ux-ui-agent-skills": true
  }
}
