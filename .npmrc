# React Native's Metro bundler (used by apps/mobile) doesn't reliably follow
# pnpm's symlinked, per-package node_modules layout — transitive deps like
# @babel/runtime end up unresolvable even though they're installed. Hoisting
# is the fix Expo's own docs recommend for pnpm monorepos:
# https://docs.expo.dev/guides/monorepos/
shamefully-hoist=true
node-linker=hoisted
