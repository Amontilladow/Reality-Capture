# Production environment — set these as secrets in your deployment platform

# Owner/superuser credential for the Postgres database itself -- used only to
# create it and to run migrations (the `migrate` one-off service in
# docker-compose.prod.yml, or Render's preDeployCommand). Never used by a
# running application.
DB_MIGRATOR_USER=engineeringos_migrator
DB_MIGRATOR_PASSWORD=<strong-random-password>

# app_user's own login -- a narrowly-privileged, RLS-subject role (migration
# 052) that `api` and `ifc-service` actually connect as at runtime. DB_USER
# is fixed at "app_user" in docker-compose.prod.yml/render.yaml; only its
# password is a secret here. Migrations keep app_user's password in sync
# with this value each time they run.
DB_PASSWORD=<strong-random-password-different-from-the-migrator-one>
JWT_ACCESS_SECRET=<min-32-char-random-string>
JWT_REFRESH_SECRET=<min-32-char-random-string>
INTERNAL_SERVICE_SECRET=<min-32-char-random-string>
S3_ACCESS_KEY_ID=<minio-or-r2-access-key>
S3_SECRET_ACCESS_KEY=<minio-or-r2-secret>
REDIS_PASSWORD=<strong-redis-password>
QDRANT_API_KEY=<qdrant-api-key>
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
FRONTEND_URL=https://app.yourdomain.com
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
